# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=fingraph
POSTGRES_USER=fingraph
POSTGRES_PASSWORD=change-me-local-only

NEO4J_PASSWORD=change-me-local-only
ELASTIC_PASSWORD=change-me-local-only

POSTGRES_PORT=5432
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
ELASTICSEARCH_PORT=9200
HELIX_PORT=7842
RISK_API_PORT=8000
DASHBOARD_PORT=3000

# Keep the external Helix service local and private for this project.
HELIX_TELEMETRY=false
